# Copy to server/.env
PORT=5050
# Secret used to sign login tokens. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# MongoDB Atlas connection string. Leave empty to use the local JSON file instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scopeshield
# Set to false to start with an empty workspace (no sample projects)
SEED_SAMPLE=true
# Your deployed frontend origin(s), comma separated
CLIENT_ORIGIN=http://localhost:5173
